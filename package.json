{
  "name": "fraktum-literature",
  "private": true,
  "version": "0.19.0",
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "preview": "node server.mjs",
    "build": "node build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "node --test tests/e2e/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:all": "npm run lint && npm run typecheck && npm run test && npm run test:integration && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "eslint": "10.13.0",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3"
  }
}
